{
  "name": "ff-tournament-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Paid Free Fire Tournament platform – Player App + Multi-Admin/Staff Panel (Firebase Auth + Firestore)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "serve": "node scripts/serve.mjs",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-fftournament",
    "seed": "node scripts/seed.mjs",
    "test": "firebase emulators:exec --only auth,firestore --project demo-fftournament \"node --test tests/rules.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:hosting": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "qrcode-generator": "^1.5.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "esbuild": "^0.28.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.0",
    "playwright": "^1.64.1"
  }
}
